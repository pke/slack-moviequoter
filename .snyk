# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
ignore: {}
# patches apply the minimum changes required to fix a vulnerability
patch:
  'npm:lodash:20180130':
    - name-to-imdb > lodash:
        patched: '2018-07-02T21:19:42.795Z'
  SNYK-JS-HTTPSPROXYAGENT-469131:
    - snyk > proxy-agent > https-proxy-agent:
        patched: '2019-10-05T04:22:15.071Z'
    - snyk > proxy-agent > pac-proxy-agent > https-proxy-agent:
        patched: '2019-10-05T04:22:15.071Z'
  SNYK-JS-LODASH-567746:
    - botbuilder > botframework-connector > adal-node > async > lodash:
        patched: '2020-05-01T07:25:05.924Z'
  'npm:semver:20150403':
    - botbuilder > botframework-connector > browserify-fs > levelup > semver:
        patched: '2024-08-29T06:35:43.195Z'
        id: 'npm:semver:20150403'
        path: botbuilder > botframework-connector > browserify-fs > levelup > semver
    - botbuilder > botbuilder-core > botframework-connector > browserify-fs > levelup > semver:
        patched: '2024-08-29T06:35:43.195Z'
        id: 'npm:semver:20150403'
        path: >-
          botbuilder > botbuilder-core > botframework-connector > browserify-fs
          > levelup > semver
